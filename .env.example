# Copy this file to ".env.local" and fill in the two values from
# Supabase Dashboard -> Project Settings -> API Keys.
#
# Use ONLY the publishable key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the service_role / secret key (sb_secret_...) or the database
# password here: everything starting with VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
