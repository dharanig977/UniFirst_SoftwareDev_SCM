# Only needed to run the CRM on your own computer. On Vercel, set the same
# names under Project -> Settings -> Environment Variables.

# Browser (bundled into the page, so public values only). Same as the ERP app:
VITE_SUPABASE_URL=https://your-erp-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only (never starts with VITE_, never reaches the browser):
# the crm_app login on Aiven. Letters and digits only in the password keep this simple.
CRM_DATABASE_URL=postgres://crm_app:YOUR_APP_PASSWORD@your-service-your-project.aivencloud.com:12345/defaultdb
# Aiven's CA certificate, the whole text including the BEGIN/END lines.
CRM_DATABASE_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"
